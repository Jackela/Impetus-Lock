# Environment variables for Impetus Lock Server
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Application
APP_ENV=development  # development, production
SECRET_KEY=your-secret-key-here-change-in-production
ENCRYPTION_KEY=your-32-byte-encryption-key-base64-encoded

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-min-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/impetus_lock

# LLM Providers
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# CORS (production)
CORS_ORIGINS=https://app.impetus-lock.com

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_INTERVENTION=10/minute
REDIS_URL=redis://localhost:6379/0

# Observability
ENABLE_METRICS=true
ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Features
ENABLE_MUSE_MODE=true
ENABLE_LOKI_MODE=true
TESTING=false

# Legacy Settings (kept for compatibility)
HOST=0.0.0.0
PORT=8000
RELOAD=True
LOG_LEVEL=INFO
