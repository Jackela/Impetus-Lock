# Copy to .env.staging or .env.production in the server deployment directory.
# Keep it readable only by the deployment account. Set distinct secrets on each server.
DEPLOY_PROJECT=impetus-staging
POSTGRES_DB=impetus
POSTGRES_USER=impetus
POSTGRES_PASSWORD=
# URL-encode password characters in the DSN. Both settings must refer to the same database.
DATABASE_URL=
SECRET_KEY=
JWT_SECRET=
ENCRYPTION_KEY=
CLIENT_BIND=127.0.0.1
CLIENT_PORT=8080
API_WORKERS=2
# Only needed for an explicitly split browser/API origin.
CORS_ORIGINS=
