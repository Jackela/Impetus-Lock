{
  "name": "impetus-lock-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint --max-warnings=0 \"src/**/*.{ts,tsx}\"",
    "format": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "node ./scripts/run-vitest.mjs run",
    "test:watch": "node ./scripts/run-vitest.mjs --watch",
    "test:e2e": "playwright test",
    "test:e2e:ci": "CI=1 PLAYWRIGHT_HEADLESS=1 VITE_API_URL=http://127.0.0.1:8000 npx playwright test",
    "test:e2e:ci-like": "playwright test --workers=1 --retries=2 --reporter=list",
    "test:e2e:sequential": "playwright test --workers=1",
    "test:e2e:preview": "node ./scripts/run-preview-e2e.mjs",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@milkdown/core": "^7.18.0",
    "@milkdown/plugin-history": "^7.18.0",
    "@milkdown/preset-commonmark": "^7.18.0",
    "@milkdown/prose": "^7.18.0",
    "@milkdown/react": "^7.22.1",
    "@milkdown/theme-nord": "^7.22.1",
    "@tanstack/react-query": "^5.102.8",
    "framer-motion": "^12.43.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "~5.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "openapi-typescript-codegen": "^0.31.0",
    "playwright": "^1.58.2",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "~5.0.1"
  }
}
