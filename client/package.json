{
  "name": "impetus-lock-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint --max-warnings=0 \"src/**/*.{ts,tsx}\"",
    "format": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "node ./scripts/run-vitest.mjs run",
    "test:watch": "node ./scripts/run-vitest.mjs --watch",
    "test:e2e": "playwright test",
    "test:e2e:ci": "CI=1 PLAYWRIGHT_HEADLESS=1 VITE_API_URL=http://127.0.0.1:8000 npx playwright test",
    "test:e2e:ci-like": "playwright test --workers=1 --retries=2 --reporter=list",
    "test:e2e:sequential": "playwright test --workers=1",
    "test:e2e:preview": "node ./scripts/run-preview-e2e.mjs",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@milkdown/core": "^7.18.0",
    "@milkdown/plugin-history": "^7.18.0",
    "@milkdown/plugin-listener": "^7.19.2",
    "@milkdown/preset-commonmark": "^7.18.0",
    "@milkdown/prose": "^7.18.0",
    "@milkdown/react": "^7.18.0",
    "@milkdown/theme-nord": "^7.18.0",
    "@tanstack/react-query": "^5.90.20",
    "framer-motion": "^12.33.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "openapi-typescript-codegen": "^0.30.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.0.7",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^61.7.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "ffmpeg-static": "^5.3.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.2.7",
    "playwright": "^1.58.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^4.0.7"
  }
}
