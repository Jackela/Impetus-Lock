          class="task-item-meta"
        >
          <time
            class="task-item-time"
            datetime="2025-02-04T09:00:00Z"
            title="2/4/2025, 9:00:00 AM"
          >
            2/4/2025
          </time>
          <span
            class="task-item-version"
