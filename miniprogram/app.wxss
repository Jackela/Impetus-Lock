page {
  background: #f5f5f7;
  color: #1d1d1f;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Noto Sans CJK SC', sans-serif;
  font-size: 17px;
  line-height: 1.47;
}

view,
text,
button,
textarea,
input,
navigator {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  max-width: 640px;
  margin: 0 auto;
  padding: 24px 24px 32px;
  padding-bottom: calc(32px + env(safe-area-inset-bottom));
}

.panel {
  border: 1px solid #e5e5ea;
  border-radius: 18px;
  background: #fff;
  padding: 20px;
}

.heading {
  display: block;
  margin: 0;
  color: #1d1d1f;
  font-size: 2.0000em;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.37px;
}

.body-copy {
  color: #1d1d1f;
  font-size: 1.0588em;
  line-height: 1.6;
}

.caption {
  color: #55555c;
  font-size: 0.8235em;
  line-height: 1.5;
}

.button-primary,
.button-secondary,
.button-link {
  display: flex;
  min-width: 44px;
  min-height: 44px;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 9px 20px;
  border: 1px solid transparent;
  border-radius: 999px;
  background: transparent;
  color: #0066cc;
  font-size: 1.0000em;
  font-weight: 400;
  line-height: 1.45;
  text-align: center;
  white-space: normal;
}

.button-primary {
  border-color: #0066cc;
  background: #0066cc;
  color: #fff;
}

.button-secondary {
  border-color: #0066cc;
}

.button-link {
  padding-left: 8px;
  padding-right: 8px;
}

.button-primary[disabled],
.button-secondary[disabled],
.button-link[disabled] {
  border-color: #e5e5ea;
  background: #e5e5ea;
  color: #66666d;
}

.button-pressed {
  opacity: 0.8;
  transform: scale(0.98);
}

.field {
  display: block;
  width: 100%;
  min-height: 44px;
  padding: 10px 12px;
  border: 1px solid #85858d;
  border-radius: 8px;
  background: #fff;
  color: #1d1d1f;
  font-size: 1.0000em;
  line-height: 1.47;
}

.field-placeholder {
  color: #595962;
}

.notice {
  display: block;
  padding: 12px 14px;
  border-radius: 8px;
  background: #eeeff3;
  color: #424249;
  font-size: 0.8824em;
  line-height: 1.45;
}

.notice-error {
  background: #faedf0;
  color: #912338;
}
