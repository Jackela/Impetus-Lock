<view class="page modes-page" style="font-size: {{fontSize}}px">
  <view class="heading" aria-role="heading">选择开场题</view>
  <view wx:if="{{loading}}" class="notice" aria-role="status">正在读取可用题目和模式…</view>
  <view wx:if="{{error}}" class="notice notice-error" aria-role="alert">
    <text>{{error}}</text>
    <button wx:if="{{!progress}}" class="button-secondary" hover-class="button-pressed" bindtap="refresh">重试读取</button>
  </view>
  <view wx:if="{{message}}" class="notice" aria-role="status">{{message}}</view>

  <block wx:if="{{progress}}">
    <radio-group class="panel modes-options" bindchange="themeChanged">
      <label class="modes-option">
        <radio value="letter" checked="{{theme === 'letter'}}" disabled="{{starting || saving}}" color="#0066cc" />
        <view>
          <view class="modes-option-title">来信</view>
          <text class="caption">十年后，你收到一封自己寄出的信。</text>
        </view>
      </label>
      <label class="modes-option">
        <radio value="detective" checked="{{theme === 'detective'}}" disabled="{{!progress.detective || starting || saving}}" color="#0066cc" />
        <view>
          <view class="modes-option-title">古风探案</view>
          <text wx:if="{{!progress.detective}}" class="caption">续写至少一段并收笔后开放。</text>
          <text wx:else class="caption">县衙还没升堂，案头已经摆好了一份结案书。</text>
        </view>
      </label>
    </radio-group>

    <view class="modes-section-title" aria-role="heading">选择模式</view>
    <radio-group class="panel modes-options" bindchange="modeChanged">
      <label class="modes-option">
        <radio value="normal" checked="{{mode === 'normal'}}" disabled="{{starting || saving}}" color="#0066cc" />
        <view>
          <view class="modes-option-title">普通模式</view>
          <text class="caption">续写后会出现锁句。锁句原文受到保护，你仍可以转向别的情节。</text>
        </view>
      </label>
      <label class="modes-option">
        <radio value="high" checked="{{mode === 'high'}}" disabled="{{!progress.high || starting || saving}}" color="#0066cc" />
        <view>
          <view class="modes-option-title">高强度模式</view>
          <text wx:if="{{progress.high}}" class="caption">{{highNotice}}</text>
          <text wx:else class="caption">续写至少一段并收笔后开放。</text>
        </view>
      </label>
    </radio-group>

    <radio-group wx:if="{{modes.length}}" class="panel modes-options modes-saved" bindchange="savedModeChanged" aria-label="已保存的个人模式">
      <label wx:for="{{modes}}" wx:key="id" class="modes-option">
        <radio value="{{item.id}}" checked="{{mode === 'custom' && modeId === item.id}}" disabled="{{starting || saving}}" color="#0066cc" />
        <view>
          <view class="modes-option-title">{{item.name}}</view>
          <text class="caption modes-rule-description">{{item.trigger === 'manual' ? '手动触发' : (item.trigger === 'response' ? '回应后触发' : '每段续写后触发')}} · {{item.action === 'insert' ? '插入文字' : (item.action === 'rewrite' ? '改写未锁正文' : '删除未锁正文')}}</text>
          <text wx:if="{{item.action !== 'delete'}}" class="caption modes-rule-description">{{item.lock ? '锁定新文字' : '新文字可以编辑'}}</text>
          <text wx:if="{{item.action === 'rewrite' || item.action === 'delete' && item.recoverable}}" class="caption modes-rule-description">保留受影响的原文。</text>
          <text wx:if="{{item.action === 'delete' && !item.recoverable}}" class="caption">可能删除未锁正文，删除后不可恢复。每次开局需确认。</text>
        </view>
      </label>
    </radio-group>

    <button class="button-primary modes-start" hover-class="button-pressed" bindtap="launch" disabled="{{starting || saving}}" loading="{{starting}}">{{starting ? '正在开局' : '开始写'}}</button>

    <view class="modes-section-title" aria-role="heading">已发现的规则</view>
    <view class="panel modes-rule-list">
      <text>插入锁句</text>
      <text>{{progress.rewrite ? '改写规则已发现' : '改写规则尚未发现'}}</text>
      <text>{{progress.delete ? '删除规则已发现' : '删除规则尚未发现'}}</text>
    </view>

    <view class="modes-section-title" aria-role="heading">创建个人模式</view>
    <text wx:if="{{!progress.rewrite}}" class="caption">完成首篇续写作品后，再在另一局回应至少一次锁句并收笔，即可开放个人模式。</text>
    <view wx:else class="panel modes-form">
      <label class="modes-field-label" for="mode-name">模式名称</label>
      <input id="mode-name" class="field" aria-label="模式名称" placeholder="例如：慢慢揭开线索" maxlength="80" value="{{name}}" disabled="{{starting || saving}}" bindinput="nameChanged" />

      <text class="modes-field-label">触发条件</text>
      <radio-group bindchange="triggerChanged" aria-label="触发条件">
        <label class="modes-option"><radio value="manual" checked="{{trigger === 'manual'}}" disabled="{{starting || saving}}" color="#0066cc" />手动触发</label>
        <label class="modes-option"><radio value="response" checked="{{trigger === 'response'}}" disabled="{{starting || saving}}" color="#0066cc" />回应后触发</label>
        <label class="modes-option">
          <radio value="automatic" checked="{{trigger === 'automatic'}}" disabled="{{starting || saving}}" color="#0066cc" />
          <view>
            <view class="modes-option-title">每段续写后触发</view>
            <text class="caption">每次新增正文成功入稿后，按所选规则触发。</text>
          </view>
        </label>
      </radio-group>

      <text class="modes-field-label">干预动作</text>
      <radio-group bindchange="actionChanged" aria-label="干预动作">
        <label class="modes-option"><radio value="insert" checked="{{action === 'insert'}}" disabled="{{starting || saving}}" color="#0066cc" />插入文字</label>
        <label class="modes-option"><radio value="rewrite" checked="{{action === 'rewrite'}}" disabled="{{!progress.rewrite || starting || saving}}" color="#0066cc" />{{progress.rewrite ? '改写未锁正文' : '改写尚未开放'}}</label>
        <label class="modes-option"><radio value="delete" checked="{{action === 'delete'}}" disabled="{{!progress.delete || starting || saving}}" color="#0066cc" />{{progress.delete ? '删除未锁正文' : '删除尚未开放'}}</label>
      </radio-group>

      <label wx:if="{{action !== 'delete'}}" class="modes-switch">
        <text>锁定新文字</text>
        <switch checked="{{lock}}" color="#0066cc" disabled="{{starting || saving}}" bindchange="lockChanged" aria-label="锁定新文字" />
      </label>

      <label wx:if="{{action === 'delete'}}" class="modes-switch">
        <text>保留被删除的原文</text>
        <switch checked="{{recoverable}}" color="#0066cc" disabled="{{starting || saving}}" bindchange="recoveryChanged" aria-label="保留被删除的原文" />
      </label>
      <text wx:if="{{action === 'delete' && !recoverable}}" class="caption">关闭后，被删除的未锁正文无法通过产品恢复。用此模式开局时每次都要确认。</text>
      <text wx:if="{{action === 'rewrite'}}" class="caption">本局可查回被改写前的文字。</text>

      <button class="button-secondary modes-save" hover-class="button-pressed" bindtap="saveMode" disabled="{{starting || saving}}" loading="{{saving}}">{{saving ? '正在保存' : '保存个人模式'}}</button>
    </view>
  </block>
</view>
