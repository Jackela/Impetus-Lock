.library-page > .caption { display: block; margin-top: 12px; }
.library-section { margin-top: 32px; }
.library-section-title { margin-bottom: 12px; font-size: 1.29em; font-weight: 600; }
.library-entry { display: flex; flex-direction: column; gap: 8px; margin: 10px 0; padding: 18px; overflow-wrap: anywhere; }
.library-entry-title { color: #1d1d1f; font-size: 1.06em; font-weight: 600; }
.library-excerpt { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.library-entry button { margin-top: 8px; }
.library-link { min-height: 44px; }
.library-new { margin-top: 28px; }
