.writing-page {
  padding-bottom: calc(40px + env(safe-area-inset-bottom));
}

.writer-top,
.writer-details {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  column-gap: 12px;
}

.writer-top {
  margin-bottom: 4px;
}

.writer-chapter {
  color: #1d1d1f;
  font-size: 1.882em;
  line-height: 1.15;
  font-weight: 650;
}

.writing-page .writer-library {
  margin: 0;
}

.manuscript {
  margin: 24px 0 32px;
}

.manuscript-opening {
  padding-bottom: 12px;
}

.story-opening,
.story-paragraph {
  display: block;
  white-space: pre-wrap;
  overflow-wrap: break-word;
  color: #1d1d1f;
}

.story-opening {
  font-size: 1.353em;
  line-height: 1.52;
  font-weight: 600;
}

.story-paragraph {
  font-size: 1.059em;
  line-height: 1.65;
}

.story-segment {
  margin: 12px 0;
}

.story-segment-locked {
  padding: 10px 12px;
  border-left: 3px solid #06c;
  border-radius: 2px 12px 12px 2px;
  background: #edf5ff;
}

.lock-status {
  display: inline-block;
  margin-bottom: 5px;
  color: #164b75;
  font-size: 0.824em;
  font-weight: 600;
}

.writing-page .button-link {
  min-height: 44px;
  margin: 0;
  padding-inline: 0;
  text-align: left;
}

.writer-row,
.segment-controls,
.voice-controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px 16px;
}

.writer-row button,
.segment-controls button,
.voice-controls button {
  margin: 0;
}

.segment-controls {
  margin-bottom: -4px;
}

.original-note,
.privacy-note {
  display: grid;
  gap: 8px;
  padding: 12px;
  border-radius: 12px;
  background: #f5f5f7;
}

.writer-panel,
.rules-panel,
.recoveries-panel {
  display: grid;
  gap: 12px;
  margin-top: 16px;
}

.writer-heading {
  color: #1d1d1f;
  font-size: 1.235em;
  line-height: 1.3;
  font-weight: 600;
}

.rules-panel .body-copy,
.writer-panel .body-copy {
  display: block;
}

.writing-page .ability-choice,
.writing-page .plot-choice {
  margin: 0;
  width: 100%;
  text-align: left;
}

.ability-choice {
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
}

.ability-choice .caption,
.ability-title {
  display: block;
  width: 100%;
}

.ability-title {
  font-weight: 600;
}

.take-over {
  justify-self: start;
}

.writer-textarea {
  min-height: 84px;
  width: 100%;
  box-sizing: border-box;
  line-height: 1.5;
  font-size: 1em;
}

.writer-picker {
  display: flex;
  align-items: center;
  min-height: 44px;
  gap: 5px;
  color: #06c;
  font-size: 0.941em;
}

.record-button {
  touch-action: none;
}

.writing-page .record-button.is-recording {
  background: #fff0ee;
  color: #842c22;
}

.writing-page .finish-entry {
  margin-top: 12px;
}
